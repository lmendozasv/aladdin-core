# If omitted, the dev server proxies API calls to `http://localhost:8080`.
VITE_CORE_API_BASE_URL=
VITE_TENANT_DOMAIN=cupontours.nexai.chat
# If omitted, pricing calls use `VITE_CORE_API_BASE_URL` (or same-origin proxy in dev).
VITE_PRICING_API_BASE_URL=

# Mapbox (Market Intelligence map)
VITE_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Firebase web config (Admin portal)
VITE_FIREBASE_API_KEY=CHANGE_ME
VITE_FIREBASE_AUTH_DOMAIN=CHANGE_ME
VITE_FIREBASE_PROJECT_ID=CHANGE_ME
VITE_FIREBASE_STORAGE_BUCKET=CHANGE_ME
VITE_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
VITE_FIREBASE_APP_ID=CHANGE_ME
VITE_FIREBASE_MEASUREMENT_ID=CHANGE_ME
